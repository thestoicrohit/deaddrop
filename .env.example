# ─────────────────────────────────────────────────────────────────────────────
# DeadDrop — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment ────────────────────────────────────────────────────────────────
# Alchemy / Infura RPC URL for Sepolia testnet
# Get a free key at: https://www.alchemy.com  (create app → Ethereum → Sepolia)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of the deployer wallet (no 0x prefix needed by dotenv)
# This wallet must have Sepolia ETH — get some at: https://sepoliafaucet.com
# IMPORTANT: this is only used during deployment (npm run deploy:sepolia).
# The app itself never touches private keys — it only ever asks for wallet signatures.
DEPLOYER_PRIVATE_KEY=your_deployer_wallet_private_key_here

# Etherscan API key for contract verification (optional)
# Get one at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── Frontend contract addresses (set after deploying) ─────────────────────────
# Run `npm run deploy:sepolia` — the script prints all six addresses.
# Paste them here, then restart the dev server.
VITE_VAULT_ADDRESS=0x...DeadDropVault_address...
VITE_KEY_REGISTRY_ADDRESS=0x...DeadDropKeyRegistry_address...
VITE_CIRCLES_ADDRESS=0x...DeadDropCircles_address...
VITE_CAPSULES_ADDRESS=0x...DeadDropCapsules_address...
VITE_SAFE_ADDRESS=0x...DeadDropSafe_address...
VITE_CREDENTIALS_ADDRESS=0x...DeadDropCredentials_address...

# ── IPFS / Pinata ─────────────────────────────────────────────────────────────
# Required for uploading encrypted content (circles, capsules, safe, vault metadata).
# Get a JWT at: https://app.pinata.cloud → API Keys → New Key (pinFileToIPFS scope).
VITE_PINATA_JWT=your_pinata_jwt_here

# ── Frontend RPC ──────────────────────────────────────────────────────────────
VITE_ALCHEMY_KEY=YOUR_ALCHEMY_KEY

# WalletConnect Project ID (optional — only if you enable WalletConnect)
# Get one at: https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# ── Optional: speed up the Activity feed ──────────────────────────────────────
# After deploying, set this to the block number of your first deploy transaction.
# Without it, useActivity fetches events from block 0 (slow on real networks).
# Find the block on Etherscan by looking at your deploy transaction.
VITE_DEPLOY_BLOCK=
